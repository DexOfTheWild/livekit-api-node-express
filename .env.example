# Required LiveKit settings
VOIP_LIVEKIT_API_KEY=your-livekit-api-key
VOIP_LIVEKIT_API_SECRET=your-livekit-api-secret
VOIP_LIVEKIT_WS_URL=wss://livekit.example.com
VOIP_ROOM_NAME=whiterun-test

# Basic server settings
PORT=3000
HOST=127.0.0.1
VOIP_LOG_LEVEL=info
VOIP_LOG_FORMAT=json
VOIP_SHUTDOWN_TIMEOUT_MS=10000
VOIP_HEALTH_EXPOSE_DETAILS=true

# Token behavior
VOIP_TOKEN_TTL_SECONDS=900

# Optional browser integration
VOIP_ALLOWED_ORIGIN=

# Optional shared-secret protection for GET /token
VOIP_TOKEN_AUTH_SECRET=
VOIP_TOKEN_AUTH_HEADER=x-voip-token-auth

# Optional in-memory per-IP rate limiting for GET /token
VOIP_RATE_LIMIT_MAX_REQUESTS=
VOIP_RATE_LIMIT_WINDOW_SECONDS=

# Optional Express proxy trust setting when behind Nginx/Caddy
# Examples: false, true, 1, loopback
VOIP_TRUST_PROXY=false
